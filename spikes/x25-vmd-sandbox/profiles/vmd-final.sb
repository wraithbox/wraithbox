(version 1)
; wb-vmd profile: what the boot, save and restore runs needed, after the
; ablation rounds (results/ablate-*.txt). Every rule here was needed by a
; boot, except machdep.cpu.brand_string (needed for saved states, below) and
; vz-framework, which is kept so a configuration error comes
; back as an NSError with its text instead of an uncaught exception.
; Parameters:
;   BUNDLE  the VM bundle directory (disks, auxiliary storage, identity, state)
;   CACHE   the per-user cache directory, from confstr(_CS_DARWIN_USER_CACHE_DIR)
;           called before confining, without the trailing slash, resolved
;           (/private/var/folders/...)
(deny default)

; The VM bundle: the framework opens the disks, reads the identity and
; auxiliary storage, and writes the saved state in this process.
(allow file-read* file-write* (subpath (param "BUNDLE")))

; The service process that runs the VM.
(allow mach-lookup (xpc-service-name "com.apple.Virtualization.VirtualMachine"))

; Configuration checks: is virtualization supported, how much memory. The
; CPU name goes into a saved state: a state saved by a process that can't
; read it restores only in such a process, and the other way round
; (results/matrix-*, results/addon-round*.txt).
(allow sysctl-read (sysctl-name "kern.hv_support" "hw.memsize" "machdep.cpu.brand_string"))
(allow file-read* (literal "/System/Library/CoreServices/SystemVersion.plist"))

; Error texts.
(allow file-read* (subpath "/System/Library/Frameworks/Virtualization.framework"))

; Finding the cache directory (the value comes from before confining).
(allow file-read-metadata (literal "/var") (literal "/private/var/folders"))

; Sandbox extensions the framework hands to the service process: device
; classes, the auxiliary storage (read), the graphics caches (read-write).
(allow generic-issue-extension
  (extension-class
    "com.apple.virtualization.extension.avp.rtc"
    "com.apple.virtualization.extension.fp"
    "com.apple.virtualization.extension.io-surface"
    "com.apple.virtualization.extension.paravirtualized-graphics"
    "com.apple.virtualization.extension.strong-identity"
    "com.apple.virtualization.extension.usb-hci"
    "com.apple.virtualization.extension.videotoolbox"))
(allow file-issue-extension
  (require-all (subpath (param "BUNDLE")) (extension-class "com.apple.app-sandbox.read")))
(allow file-issue-extension
  (require-all (subpath (param "CACHE")) (extension-class "com.apple.app-sandbox.read-write")))
