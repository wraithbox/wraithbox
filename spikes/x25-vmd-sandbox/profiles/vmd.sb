(version 1)
; wb-vmd candidate profile (vmd-v5 split into sections for ablate.sh).
; Parameters: BUNDLE (the VM bundle), CACHE (the per-user cache directory,
; resolved with confstr before confining). Each ";; [name]" line starts a
; section that ablate.sh can drop.
(deny default)

;; [bundle]
(allow file-read* file-write* (subpath (param "BUNDLE")))

;; [vz-service]
(allow mach-lookup (xpc-service-name "com.apple.Virtualization.VirtualMachine"))

;; [diskimages]
(allow mach-lookup (xpc-service-name "com.apple.diskimagescontroller"))

;; [sysctl]
(allow sysctl-read
  (sysctl-name "kern.hv_support" "hw.memsize" "machdep.cpu.brand_string" "kern.maxfilesperproc"))

;; [disk-space]
(allow system-info (info-type "vfs.disk-space"))

;; [icu]
(allow file-read* (literal "/usr/share/icu/icudt78l.dat"))

;; [system-version]
(allow file-read* (literal "/System/Library/CoreServices/SystemVersion.plist"))

;; [vz-framework]
(allow file-read* (subpath "/System/Library/Frameworks/Virtualization.framework"))

;; [var-metadata]
(allow file-read-metadata (literal "/var") (literal "/private/var/folders"))

;; [cache]
(allow file-read* file-write* (subpath (param "CACHE")))

;; [generic-extensions]
(allow generic-issue-extension
  (extension-class
    "com.apple.virtualization.extension.avp.rtc"
    "com.apple.virtualization.extension.fp"
    "com.apple.virtualization.extension.io-surface"
    "com.apple.virtualization.extension.paravirtualized-graphics"
    "com.apple.virtualization.extension.strong-identity"
    "com.apple.virtualization.extension.usb-hci"
    "com.apple.virtualization.extension.videotoolbox"))

;; [bundle-extensions]
(allow file-issue-extension
  (require-all
    (subpath (param "BUNDLE"))
    (extension-class "com.apple.app-sandbox.read" "com.apple.app-sandbox.read-write")))

;; [cache-extensions]
(allow file-issue-extension
  (require-all
    (subpath (param "CACHE"))
    (extension-class "com.apple.app-sandbox.read-write")))
