<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- wb-vmd's one entitlement: the Virtualization framework
     (S15-01-rights, "Hardening and entitlements"). A new entitlement needs
     a change there first. `mise run swift:sign` checks that the signed
     binary holds exactly this set. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
