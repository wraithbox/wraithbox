---
/**
 * Starlight `ThemeProvider` override: dark is the default theme.
 *
 * Starlight's default is "auto" (follow the operating system). This site
 * defaults to dark instead, and still respects an explicit choice made with
 * the theme toggle (ThemeSelect.astro, the other half of this override).
 *
 * The choice is stored under Starlight's own `localStorage` key,
 * `starlight-theme`, with these meanings:
 *
 *   'dark' / 'light'  the reader picked that theme
 *   'auto'            the reader picked "Auto": follow prefers-color-scheme
 *   anything else     no choice yet: dark
 *
 * Stock Starlight stores "auto" as an empty string, so it cannot tell
 * "picked Auto" from "never chose". This override stores 'auto' explicitly
 * and treats the empty string (left behind by an earlier version of the
 * site) as "no choice", that is dark.
 *
 * Copied from @astrojs/starlight 0.43.1's ThemeProvider.astro; only the
 * theme resolution differs. Since 0.43 the theme select no longer uses a
 * global from this script: ThemeSelect.astro sets its own picker.
 * Check it again when upgrading Starlight.
 * The script is inline, as upstream's is, so the theme is set before
 * first paint (no flash of the wrong theme).
 */
---

<script is:inline>
	(() => {
		const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
		/** The reader's choice; no choice (or an unknown value) means the dark default. */
		const choice = stored === 'light' || stored === 'dark' || stored === 'auto' ? stored : 'dark';
		const theme =
			choice === 'auto'
				? window.matchMedia('(prefers-color-scheme: light)').matches
					? 'light'
					: 'dark'
				: choice;
		document.documentElement.dataset.theme = theme;
	})();
</script>
