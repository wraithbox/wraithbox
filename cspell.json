{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "dictionaries": ["softwareTerms", "companies", "golang", "swift", "project-words"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./cspell-words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    ".astro",
    ".build",
    ".vale/styles",
    "cspell-words.txt",
    "bun.lock",
    "mise.lock",
    "go.sum",
    "Package.resolved",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    "*.svg",
    "*.png",
    "*.ico"
  ],
  "ignoreRegExpList": ["/GHSA(-[a-z0-9]{4}){3}/g", "/\\b(?=[0-9a-f]*[0-9])[0-9a-f]{6}\\b/gi"],
  "languageSettings": [
    {
      "languageId": "markdown,mdx",
      "ignoreRegExpList": ["/`[^`\\n]+`/g"]
    }
  ]
}
